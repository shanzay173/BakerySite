# Port the Express server listens on
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017

# Database name
DB_NAME=BakeryDB

# Comma-separated list of origins allowed by CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# SMTP settings used to send order emails (left empty = emails skipped with a warning)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Email address shown as the sender
FROM_EMAIL=

# Bakery owner inbox that receives every new order notification
OWNER_EMAIL=

# Display name used across order emails and the success page
BAKERY_NAME=Hearth & Bloom

# Promised delivery window in minutes (used in emails and the success page)
DELIVERY_TIME_MINUTES=60
